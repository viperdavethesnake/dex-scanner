                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Skip If No Pending": {
            "main": [
                [
                    {
                        "node": "Fetch Current Price",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Current Price": {
            "main": [
                [
                    {
                        "node": "Prep Update Data",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prep Update Data": {
            "main": [
                [
                    {
                        "node": "Update Outcome",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
