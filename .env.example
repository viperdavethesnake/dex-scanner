# DEX Scanner — environment variables
# Copy to .env and fill in real values. This file is tracked in git; .env is not.

# --- SCANNER ---
BIRDEYE_API_KEY=your_birdeye_api_key_here
N8N_JWT=your_n8n_jwt_here

# --- COLLECTOR ---
COLLECTOR_BIRDEYE_ENRICHMENT=false
COLLECTOR_BIRDEYE_SAMPLE_RATE=0.02
COLLECTOR_BIRDEYE_MAX_PER_CYCLE=20

# --- TRADER: AGGREGATOR KEYS ---
ZEROX_API_KEY=your_0x_api_key_here
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/your_key_here
JUPITER_API_KEY=your_jupiter_key_here

# --- TRADER: DRIFT GATE (asymmetric, momentum-aligned) ---
# Downward: reject when 0x price is this far BELOW signal (momentum already failed).
# Upward:   reject when 0x price is this far ABOVE signal (over-extended, scalp edge gone).
QUOTE_DRIFT_DOWN_MAX_PCT=1.5
QUOTE_DRIFT_UP_MAX_PCT=15.0

# --- TRADER: EXIT FALLBACK COST ESTIMATES ---
# Used when aggregator returns None at exit (no liquidity). Prevents gross≈net inflation.
# Identify these rows via exit_quote_source='dexscreener_fallback'.
FALLBACK_EXIT_GAS_USD=0.20
FALLBACK_EXIT_SLIPPAGE_BPS=300

# --- TRADER: WALLET ---
# Add before shadow-to-live transition only. Must not be set in shadow mode.
# TRADER_WALLET_PRIVATE_KEY=
