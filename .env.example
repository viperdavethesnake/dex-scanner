# DEX Scanner — environment variable contract
# Copy to .env and fill in real values. Never commit .env.
#
# .env is gitignored. A pre-commit hook (gitleaks) will block commits
# containing detected secrets as a second line of defense.

# Birdeye Data Services API key
# Get from: https://bds.birdeye.so → API Keys → Create
BIRDEYE_API_KEY=your_birdeye_api_key_here

# n8n JWT API key — used for workflow API calls (Claude Code sessions)
# Generate from: n8n UI → Settings → API → Create API Key
# Expires periodically — regenerate when 401s appear
N8N_JWT=your_n8n_jwt_here

# Collector Birdeye enrichment (Base-only)
# Master switch — set to "true" to enable. Default off to protect CU budget.
COLLECTOR_BIRDEYE_ENRICHMENT=false
# Fraction of Base tokens enriched per cycle (0.02 = 2%). Budget: ~11,700 CU/month at 0.02.
# Increase to 0.03 only after confirming actual scanner-enricher CU on bds.birdeye.so dashboard.
COLLECTOR_BIRDEYE_SAMPLE_RATE=0.02
# Hard cap on Birdeye calls per 5-min cycle regardless of sample rate.
COLLECTOR_BIRDEYE_MAX_PER_CYCLE=20
